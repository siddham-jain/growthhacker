{
  "$defs": {
    "Advisory": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "title_stale_year",
            "chapters_needed",
            "localizations_not_updated",
            "too_many_hashtags",
            "invalid_chapters",
            "shorts_links_not_clickable",
            "manual_review"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message",
        "risk"
      ],
      "title": "Advisory",
      "type": "object"
    },
    "AgeMethod": {
      "enum": [
        "observed",
        "interpolated",
        "owner_analytics",
        "age_band_proxy",
        "pending",
        "unavailable"
      ],
      "title": "AgeMethod",
      "type": "string"
    },
    "ChannelRole": {
      "enum": [
        "own",
        "competitor",
        "niche",
        "benchmark",
        "creator"
      ],
      "title": "ChannelRole",
      "type": "string"
    },
    "ClaimLevel": {
      "enum": [
        "L0_navigational",
        "L1_context",
        "L2_coverage",
        "L3_applicability"
      ],
      "title": "ClaimLevel",
      "type": "string"
    },
    "CollaborationEvidence": {
      "additionalProperties": false,
      "properties": {
        "competitor_channel_id": {
          "pattern": "^UC[0-9A-Za-z_-]{22}$",
          "title": "Competitor Channel Id",
          "type": "string"
        },
        "competitor_name": {
          "title": "Competitor Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mentioned_by_competitor",
            "mentions_competitor",
            "sponsor_language",
            "disclosed_paid_promotion"
          ],
          "title": "Kind",
          "type": "string"
        },
        "matched_on": {
          "enum": [
            "handle",
            "channel_url",
            "custom_url",
            "website_domain",
            "brand_name"
          ],
          "title": "Matched On",
          "type": "string"
        },
        "matched_token": {
          "title": "Matched Token",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "video_id": {
          "pattern": "^[0-9A-Za-z_-]{11}$",
          "title": "Video Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "competitor_channel_id",
        "competitor_name",
        "video_id",
        "published_at",
        "matched_on",
        "matched_token"
      ],
      "title": "CollaborationEvidence",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/ConfidenceBasis",
          "default": "standard"
        },
        "caps_applied": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Caps Applied",
          "type": "array"
        },
        "channels": {
          "minimum": 0,
          "title": "Channels",
          "type": "integer"
        },
        "label": {
          "$ref": "#/$defs/ConfidenceLabel"
        },
        "matching_videos": {
          "default": 0,
          "minimum": 0,
          "title": "Matching Videos",
          "type": "integer"
        },
        "outliers": {
          "minimum": 0,
          "title": "Outliers",
          "type": "integer"
        },
        "rule_id": {
          "$ref": "#/$defs/ConfidenceRuleId",
          "default": "default_v1"
        }
      },
      "required": [
        "label",
        "outliers",
        "channels"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceBasis": {
      "enum": [
        "standard",
        "first_mover",
        "rule_based"
      ],
      "title": "ConfidenceBasis",
      "type": "string"
    },
    "ConfidenceLabel": {
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "title": "ConfidenceLabel",
      "type": "string"
    },
    "ConfidenceRuleId": {
      "enum": [
        "default_v1",
        "creator_v1",
        "news_v1",
        "refresh_v1"
      ],
      "title": "ConfidenceRuleId",
      "type": "string"
    },
    "ConversionActionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "url"
      ],
      "title": "ConversionActionRef",
      "type": "object"
    },
    "CreatorConsistency": {
      "additionalProperties": false,
      "properties": {
        "gap_cv": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gap Cv"
        },
        "hit_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hit Rate"
        },
        "last_upload_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Upload At"
        },
        "median_gap_days": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Gap Days"
        }
      },
      "required": [
        "median_gap_days",
        "gap_cv",
        "hit_rate",
        "last_upload_at"
      ],
      "title": "CreatorConsistency",
      "type": "object"
    },
    "CreatorPerformance": {
      "additionalProperties": false,
      "properties": {
        "comparison_age_days": {
          "title": "Comparison Age Days",
          "type": "integer"
        },
        "median_outlier_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Outlier Ratio"
        },
        "median_views_at_age": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Views At Age"
        },
        "niche_median_views_at_age": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Niche Median Views At Age"
        }
      },
      "required": [
        "median_outlier_ratio",
        "median_views_at_age",
        "niche_median_views_at_age",
        "comparison_age_days"
      ],
      "title": "CreatorPerformance",
      "type": "object"
    },
    "CreatorRelevance": {
      "additionalProperties": false,
      "properties": {
        "match_share": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Match Share",
          "type": "number"
        },
        "topics_covered": {
          "title": "Topics Covered",
          "type": "integer"
        }
      },
      "required": [
        "match_share",
        "topics_covered"
      ],
      "title": "CreatorRelevance",
      "type": "object"
    },
    "CreatorSubject": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "pattern": "^UC[0-9A-Za-z_-]{22}$",
          "title": "Channel Id",
          "type": "string"
        },
        "collaborations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CollaborationEvidence"
          },
          "title": "Collaborations",
          "type": "array"
        },
        "consistency": {
          "$ref": "#/$defs/CreatorConsistency"
        },
        "declared_country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Country"
        },
        "handle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handle"
        },
        "kind": {
          "const": "creator",
          "default": "creator",
          "title": "Kind",
          "type": "string"
        },
        "performance": {
          "$ref": "#/$defs/CreatorPerformance"
        },
        "relevance": {
          "$ref": "#/$defs/CreatorRelevance"
        },
        "subscriber_band": {
          "$ref": "#/$defs/SubscriberBand"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "uploads_90d": {
          "title": "Uploads 90D",
          "type": "integer"
        },
        "uploads_checked": {
          "title": "Uploads Checked",
          "type": "integer"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "title",
        "url",
        "subscriber_band",
        "uploads_90d",
        "uploads_checked",
        "relevance",
        "performance",
        "consistency"
      ],
      "title": "CreatorSubject",
      "type": "object"
    },
    "EvidenceNumber": {
      "additionalProperties": false,
      "properties": {
        "display": {
          "title": "Display",
          "type": "string"
        },
        "unit": {
          "enum": [
            "count",
            "views",
            "ratio_x",
            "percent",
            "days",
            "minutes",
            "seconds",
            "videos",
            "channels",
            "year",
            "currency"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit",
        "display"
      ],
      "title": "EvidenceNumber",
      "type": "object"
    },
    "EvidenceSource": {
      "enum": [
        "youtube_public",
        "youtube_own_analytics",
        "spotlit_ai_tracking",
        "website",
        "news",
        "client_config"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "ExpectedRange": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "peer",
            "blended",
            "own",
            "peer_only_no_baseline",
            "insufficient",
            "not_applicable"
          ],
          "title": "Basis",
          "type": "string"
        },
        "comparison_age_days": {
          "title": "Comparison Age Days",
          "type": "integer"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "High"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Low"
        },
        "n_own": {
          "default": 0,
          "title": "N Own",
          "type": "integer"
        },
        "n_peer": {
          "default": 0,
          "title": "N Peer",
          "type": "integer"
        },
        "n_peer_effective": {
          "default": 0.0,
          "title": "N Peer Effective",
          "type": "number"
        },
        "size_note": {
          "anyOf": [
            {
              "enum": [
                "peers_much_smaller",
                "peers_much_larger"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Note"
        },
        "views_at_age_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Views At Age Range"
        }
      },
      "required": [
        "low",
        "high",
        "basis",
        "comparison_age_days",
        "display"
      ],
      "title": "ExpectedRange",
      "type": "object"
    },
    "FormatSuggestion": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "short",
            "long_explainer",
            "tutorial",
            "live_or_premiere"
          ],
          "title": "Format",
          "type": "string"
        },
        "rationale_codes": {
          "default": [],
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "title": "Rationale Codes",
          "type": "array"
        }
      },
      "required": [
        "format"
      ],
      "title": "FormatSuggestion",
      "type": "object"
    },
    "GapEvidence": {
      "additionalProperties": false,
      "properties": {
        "client_best_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Best Ratio"
        },
        "client_last_covered_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Last Covered At"
        },
        "client_videos_matching": {
          "title": "Client Videos Matching",
          "type": "integer"
        },
        "competitors_covering": {
          "title": "Competitors Covering",
          "type": "integer"
        },
        "competitors_total": {
          "title": "Competitors Total",
          "type": "integer"
        },
        "gap_size": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Gap Size",
          "type": "number"
        },
        "gap_type": {
          "enum": [
            "uncovered",
            "stale",
            "underperforming",
            "none"
          ],
          "title": "Gap Type",
          "type": "string"
        },
        "niche_outliers_matching": {
          "title": "Niche Outliers Matching",
          "type": "integer"
        },
        "topic_id": {
          "title": "Topic Id",
          "type": "string"
        },
        "window_outliers_total": {
          "title": "Window Outliers Total",
          "type": "integer"
        }
      },
      "required": [
        "topic_id",
        "gap_type",
        "competitors_covering",
        "competitors_total",
        "niche_outliers_matching",
        "window_outliers_total",
        "client_videos_matching",
        "gap_size"
      ],
      "title": "GapEvidence",
      "type": "object"
    },
    "InsertionAnchor": {
      "additionalProperties": false,
      "properties": {
        "anchor_excerpt": {
          "maxLength": 80,
          "title": "Anchor Excerpt",
          "type": "string"
        },
        "anchor_hash": {
          "title": "Anchor Hash",
          "type": "string"
        },
        "char_offset_hint": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Offset Hint"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "anchor_excerpt",
        "anchor_hash"
      ],
      "title": "InsertionAnchor",
      "type": "object"
    },
    "InsertionKind": {
      "enum": [
        "insert",
        "link_fix"
      ],
      "title": "InsertionKind",
      "type": "string"
    },
    "InsertionOp": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/InsertionAnchor"
        },
        "claim_level": {
          "$ref": "#/$defs/ClaimLevel"
        },
        "hashtags_added": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Hashtags Added",
          "type": "array"
        },
        "keywords_added": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Keywords Added",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/InsertionKind"
        },
        "old_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Text"
        },
        "op_id": {
          "title": "Op Id",
          "type": "string"
        },
        "phrased_by": {
          "enum": [
            "template",
            "llm"
          ],
          "title": "Phrased By",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/InsertionPosition"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "text_bytes": {
          "title": "Text Bytes",
          "type": "integer"
        },
        "trigger_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Trigger Ids",
          "type": "array"
        }
      },
      "required": [
        "op_id",
        "kind",
        "position",
        "anchor",
        "text",
        "text_bytes",
        "claim_level",
        "phrased_by"
      ],
      "title": "InsertionOp",
      "type": "object"
    },
    "InsertionPosition": {
      "enum": [
        "top_line",
        "after_first_paragraph",
        "before_hashtag_line",
        "before_links_block",
        "append"
      ],
      "title": "InsertionPosition",
      "type": "string"
    },
    "Lens": {
      "enum": [
        "views",
        "conversion"
      ],
      "title": "Lens",
      "type": "string"
    },
    "LensAssignment": {
      "additionalProperties": false,
      "properties": {
        "lens": {
          "$ref": "#/$defs/Lens"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "lens",
        "reasons"
      ],
      "title": "LensAssignment",
      "type": "object"
    },
    "NewsCompliance": {
      "additionalProperties": false,
      "properties": {
        "disclaimers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Disclaimers",
          "type": "array"
        },
        "review_required": {
          "title": "Review Required",
          "type": "boolean"
        },
        "safety_flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SafetyFlag"
          },
          "title": "Safety Flags",
          "type": "array"
        }
      },
      "required": [
        "review_required"
      ],
      "title": "NewsCompliance",
      "type": "object"
    },
    "NewsExtras": {
      "additionalProperties": false,
      "properties": {
        "compliance": {
          "$ref": "#/$defs/NewsCompliance"
        },
        "conversion_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConversionActionRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format_suggestion": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormatSuggestion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_sources": {
          "items": {
            "$ref": "#/$defs/NewsSourceRef"
          },
          "title": "Reference Sources",
          "type": "array"
        },
        "urgency": {
          "enum": [
            "now",
            "this_week",
            "evergreen_window"
          ],
          "title": "Urgency",
          "type": "string"
        }
      },
      "required": [
        "reference_sources",
        "urgency",
        "compliance"
      ],
      "title": "NewsExtras",
      "type": "object"
    },
    "NewsSourceRef": {
      "additionalProperties": false,
      "properties": {
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "tier": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceTier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "publisher",
        "published_at"
      ],
      "title": "NewsSourceRef",
      "type": "object"
    },
    "NewsSubject": {
      "additionalProperties": false,
      "properties": {
        "angle": {
          "title": "Angle",
          "type": "string"
        },
        "compliance": {
          "$ref": "#/$defs/NewsCompliance"
        },
        "conversion_action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversion Action Id"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "format_suggestion": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormatSuggestion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key_entity": {
          "title": "Key Entity",
          "type": "string"
        },
        "kind": {
          "const": "news",
          "default": "news",
          "title": "Kind",
          "type": "string"
        },
        "news_signal_id": {
          "format": "uuid",
          "title": "News Signal Id",
          "type": "string"
        },
