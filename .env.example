# copy to .env (gitignored) and fill in; never commit real values
# provider secrets and infra urls use the names below; every other setting is GH_<SECTION>__<KEY>

# required: youtube data api v3 (google cloud console)
YOUTUBE_API_KEY=
# yt-dlp fallback when the data api fails; it scrapes youtube.com and is outside the data api policies
GH_YOUTUBE__FALLBACK__ENABLED=true

# required: llm for context extraction and card writing (anthropic primary)
ANTHROPIC_API_KEY=
# optional: override the anthropic endpoint
ANTHROPIC_BASE_URL=
# set to false to force every llm task onto its deterministic fallback
LLM_ENABLED=true

# optional: openai-compatible fallback provider (openai, azure v1, openrouter, together, groq, vllm)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL_LOW=
LLM_FALLBACK_MODEL_MEDIUM=
LLM_FALLBACK_MODEL_HIGH=

# recommended: web search for competitor discovery and fresh news/research
TAVILY_API_KEY=

# optional: youtube analytics api (only works for a channel you own)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/youtube/callback

# optional: research lookups for healthcare clients (raise rate limits)
NCBI_API_KEY=
OPENFDA_API_KEY=

# local infra (defaults work with homebrew services or docker compose)
DATABASE_URL=postgresql+asyncpg://growth:growth@localhost:5432/growthhacker
REDIS_URL=redis://localhost:6379/0

# evaluation freeze bundles (local path; object storage in prod)
EVAL_BUNDLE_DIR=

# security: json list, first key encrypts; generate with
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GH_SECURITY__TOKEN_ENCRYPTION_KEYS=[]
GH_SECURITY__HASH_PEPPER=
# false only for plain-http local development
GH_API__SESSION_COOKIE_SECURE=true

# app and policy
GH_APP__ENV=local
GH_APP__LOG_JSON=false
# strict_30d until the youtube derived-metrics audit is approved, then derived_metrics_36m
GH_POLICY__RETENTION_MODE=strict_30d

# tests (read by backend/tests/conftest.py)
GH_TEST_DATABASE_URL=postgresql+asyncpg://growth:growth@localhost:5432/growthhacker_test
GH_TEST_REDIS_URL=redis://localhost:6379/15
