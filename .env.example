# copy to .env (gitignored) and fill in

# required: youtube data api v3 (google cloud console)
YOUTUBE_API_KEY=

# required: llm for context extraction and card writing
ANTHROPIC_API_KEY=

# recommended: web search for competitor discovery and fresh news/research
TAVILY_API_KEY=

# optional: youtube analytics api (only works for a channel you own)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/youtube/callback

# optional: pubmed research lookups for healthcare clients (raises rate limit)
NCBI_API_KEY=

# local infra (defaults work with docker compose)
DATABASE_URL=postgresql+asyncpg://growth:growth@localhost:5432/growthhacker
REDIS_URL=redis://localhost:6379/0
